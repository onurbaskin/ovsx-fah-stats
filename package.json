{
	"name": "folding-at-home-stats",
	"version": "0.1.16",
	"repository": {
		"type": "git",
		"url": "https://github.com/onurbaskin/ovsx-fah-stats.git"
	},
	"main": "./out/extension.js",
	"devDependencies": {
		"@types/node": "^25.5.2",
		"@types/vscode": "^1.110.0",
		"@typescript-eslint/eslint-plugin": "^8.54.0",
		"@typescript-eslint/parser": "^8.54.0",
		"bun-types": "^1.3.8",
		"esbuild": "^0.28.0",
		"eslint": "^10.2.0",
		"ovsx": "^0.10.8",
		"typescript": "^6.0.2",
		"vsce": "^2.15.0"
	},
	"dependencies": {},
	"activationEvents": [
		"onStartupFinished"
	],
	"categories": [
		"Other"
	],
	"keywords": [
		"folding",
		"foldingathome",
		"folding@home",
		"stats",
		"statistics",
		"science",
		"research",
		"distributed-computing"
	],
	"contributes": {
		"commands": [
			{
				"command": "fah-stats.refresh",
				"title": "Refresh Folding@Home Stats",
				"category": "Folding@Home Stats"
			},
			{
				"command": "fah-stats.copyStats",
				"title": "Copy Folding@Home Stats to Clipboard",
				"category": "Folding@Home Stats"
			},
			{
				"command": "fah-stats.openProfile",
				"title": "Open Folding@Home Profile",
				"category": "Folding@Home Stats"
			},
			{
				"command": "fah-stats.pauseUpdates",
				"title": "Toggle Pause Updates",
				"category": "Folding@Home Stats"
			},
			{
				"command": "fah-stats.welcome",
				"title": "Open Welcome Page",
				"category": "Folding@Home Stats"
			},
			{
				"command": "fah-stats.reset",
				"title": "Reset Configuration",
				"category": "Folding@Home Stats"
			}
		],
		"configuration": {
			"title": "Folding@Home Stats",
			"properties": {
				"fahStats.userId": {
					"type": "string",
					"default": "",
					"description": "Your Folding@Home user ID (numeric ID, required for fetching statistics)"
				},
				"fahStats.teamName": {
					"type": "string",
					"default": "",
					"description": "Preferred team name to track (optional - if not specified, the team with largest contribution will be selected)"
				},
				"fahStats.refreshInterval": {
					"type": "number",
					"default": 300,
					"description": "Refresh interval in seconds (default: 300 = 5 minutes)",
					"minimum": 10
				},
				"fahStats.paused": {
					"type": "boolean",
					"default": false,
					"description": "Pause automatic updates (global)"
				},
				"fahStats.showLastWork": {
					"type": "boolean",
					"default": true,
					"description": "Show last recorded work time in the status bar"
				},
				"fahStats.showTeamInfo": {
					"type": "boolean",
					"default": true,
					"description": "Show team statistics in the status bar and tooltip (disable to hide team info entirely)"
				},
				"fahStats.compactStatusBar": {
					"type": "boolean",
					"default": false,
					"description": "Show a shorter status bar entry"
				},
				"fahStats.statusBarTemplate": {
					"type": "string",
					"default": "",
					"description": "Custom status bar template. Available variables: {user}, {rank}, {score}, {team}, {teamRank}, {teamScore}, {lastWork}, {updatedAt}"
				},
				"fahStats.tooltipFormat": {
					"type": "string",
					"default": "markdown",
					"enum": [
						"plain",
						"markdown"
					],
					"description": "Tooltip format style (plain text or markdown)"
				}
			}
		}
	},
	"displayName": "Folding at Home Stats",
	"description": "Display Folding@Home statistics in the VS Code status bar. Track your contributions to scientific research while you code!",
	"icon": "media/icons/folding-at-home-logo.png",
	"engines": {
		"vscode": "^1.99.0"
	},
	"license": "MIT",
	"publisher": "onurbaskin",
	"scripts": {
		"compile": "node esbuild.config.js --production",
		"test": "bun test",
		"package": "bun run compile && mkdir -p packages && bun vsce package --out packages/",
		"publish:ovsx": "bun run compile && bun ovsx publish --pat \"${OVSX_PAT}\"",
		"publish:vscode": "bun run compile && bun vsce publish"
	},
	"files": [
		"out/**",
		"media/icons/**",
		"media/welcome.html",
		"package.json",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	]
}
